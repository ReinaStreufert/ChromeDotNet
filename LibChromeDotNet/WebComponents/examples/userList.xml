<webComponent name="userList" bindingType="ComponentNamespace.UserList">
  <templateBody>
    <div class="scroll-box">
      <enumerate enumeration="Users" each="user">
        <userItem User="$:user">
          <eventListener event="click">
            <selectedUser substitute="user"/>
          </eventListener>
        </userItem>
      </enumerate>
    </div>
  </templateBody>
</webComponent>