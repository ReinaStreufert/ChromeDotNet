<webComponent name="userItem">
  <bindings>
    <property name="User" type="MyNamespace.User"/>
  </bindings>
  <templateBody>
    <div class="$:inline-box">
      <enumerate enumeration="Users" each="user">
        <substitute template="userItem">
          <parameter name="User" substitute="user"/>
          <eventListener event="click">
            <handler binding="OnSelectedUserChanged">
              <parameter name="selectedUser" substitute="user"/>
            </handler>
          </eventListener>
        </substitute>
      </enumerate>
    </div>
  </templateBody>
</webComponent>